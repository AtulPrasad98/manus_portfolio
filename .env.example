# Static portfolio preview/build does not require environment variables.
# Copy to .env only for the optional full-stack server and configure actual
# values privately. Never commit .env or paste secrets into source files.
NODE_ENV=development
PORT=3000

# Private server-side values. Configure only what the selected integrations use.
DATABASE_URL=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_API_KEY=
OWNER_OPEN_ID=

# Platform identifiers/endpoints. These may be serialized into browser config;
# MANUS_API_BROWSER_KEY must be a browser-safe, appropriately restricted key.
MANUS_PROJECT_ID=
MANUS_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_BROWSER_KEY=
